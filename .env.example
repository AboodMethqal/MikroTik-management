# SQLite is used for the local/testing edition.
# The database file is created under the Prisma directory by default.
DATABASE_URL="file:./dev.db"

# Remote database (Vercel production, Turso / libSQL).
# Leave DATABASE_URL as the file: path for local development — the driver is
# selected automatically from the URL scheme:
#   file:/relative/path.db ......... local SQLite (@prisma/adapter-better-sqlite3)
#   libsql://xxx.turso.io ........ Turso / libSQL (@prisma/adapter-libsql)
#   postgres://... ................ PostgreSQL (future option, see note below)
#
# PostgreSQL support is preserved (prisma/schema.postgresql.prisma,
# prisma/migrations-postgresql/, src/lib/prisma.postgresql.ts) but is NOT the
# current production database. Switching to it requires generating the Prisma
# client from the PostgreSQL schema.
#
# Turso auth token. The first matching variable is used:
#   DATABASE_AUTH_TOKEN / TURSO_AUTH_TOKEN / PRISMA_DB_AUTH_TOKEN
# DATABASE_AUTH_TOKEN=""

# Schema sync for remote libSQL/Turso (prisma migrate deploy cannot reach a
# remote libSQL database). Read-only by default:
#   npm run db:ensure-schema          -> report
#   npm run db:ensure-schema:apply    -> create only missing objects

# Authentication
AUTH_SECRET=generate-a-long-random-secret-with-openssl-rand-base64-48
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# Auth.js v5 returns UntrustedHost for every auth request unless this is true.
# Keep "true" for local development; in production set AUTH_URL to your public
# origin instead (see .env.production.postgresql.example).
AUTH_TRUST_HOST=true

# Virtual (mock) MikroTik router for development and testing without hardware.
# Set to "false" (or omit) in production. When disabled, the demo router cannot
# be created or connected, and real RouterOS behaviour is unchanged.
# Real router connection failures are never answered by the mock.
MOCK_ROUTER_ENABLED=false

# Production PostgreSQL is intentionally kept separately in:
# .env.production.postgresql.example
